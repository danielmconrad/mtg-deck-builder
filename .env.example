# Project defaults for the CLI. Copy this file to .env (which Git ignores) and edit it there.
# Command-line options always win over these values.

# Default --format for deck:export: text, moxfield or archidekt. deck:files always writes both
# archidekt and moxfield.
MTG_EXPORT_FORMAT=archidekt

# Collections you don't want to dismantle: comma-separated path globs relative to the project root,
# matching a collection file, its path without .csv or .txt, or a folder it's in (* within a name, ** across folders).
# Their cards are reported but never fill a deck. Override per command with --protect PATTERNS.
# deck:build puts built decks in collections/<owner>/decks/, so keep that folder protected too.
MTG_PROTECTED_COLLECTIONS=collections/**/precons,collections/**/decks

# Collections to read, as path globs like the above (e.g. collections/conrad*,collections/other*);
# the rest are ignored entirely. Empty means every collection.
# Override per command with --collections PATTERNS. scryfall:refresh always covers every collection.
MTG_COLLECTIONS=

# Default output for commands that can print JSON (collection:check, collection:search, deck:check,
# deck:stats, deck:show, deck:candidates, deck:upgrades, deck:verify, decks:check and the deck:build,
# deck:teardown and deck:swap plans): text or json. --json and --no-json override it.
MTG_OUTPUT=

# deck:new's ownership policies: true or false (empty means false). --unlimited-basics,
# --no-unlimited-basics, --allow-proxies and --no-allow-proxies override them.
MTG_UNLIMITED_BASICS=
MTG_ALLOW_PROXIES=

# Where deck:build writes a deck's own list: {owner} is the deck's folder under builds/ (brad for
# builds/brad/elves, empty for builds/elves) and {name} its name. Keep it inside a protected folder.
# Defaults to collections/{owner}/decks/{name}.txt; --to overrides it.
MTG_BUILD_DESTINATION=
