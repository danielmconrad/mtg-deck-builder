# Project defaults for the CLI. Copy this file to .env (which Git ignores) and edit it there.
# Command-line options always win over these values.

# Default --format for deck:export and deck:files: text, moxfield or archidekt.
MTG_EXPORT_FORMAT=archidekt

# Collections you don't want to dismantle, comma-separated, named after their collections/*.csv files.
# Their cards are reported but never fill a deck. Override per command with --protect NAMES.
MTG_PROTECTED_COLLECTIONS=Precons

# Collections to read, comma-separated; the rest are ignored entirely. Empty means every collection.
# Override per command with --collections NAMES. cards:refresh always covers every collection.
MTG_COLLECTIONS=
