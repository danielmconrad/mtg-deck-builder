# Project defaults for the CLI. Copy this file to .env (which Git ignores) and edit it there.
# Command-line options always win over these values.

# Default --format for deck:export: text, moxfield or archidekt. deck:files always writes both
# archidekt and moxfield.
MTG_EXPORT_FORMAT=archidekt

# Collections you don't want to dismantle: comma-separated path globs relative to the project root,
# matching a collection file, its path without .csv or .txt, or a folder it's in (* within a name, ** across folders).
# Their cards are reported but never fill a deck. Override per command with --protect PATTERNS.
MTG_PROTECTED_COLLECTIONS=collections/**/precons

# Collections to read, as path globs like the above (e.g. collections/conrad*,collections/other*);
# the rest are ignored entirely. Empty means every collection.
# Override per command with --collections PATTERNS. scryfall:refresh always covers every collection.
MTG_COLLECTIONS=
